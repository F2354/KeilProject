   1          #include <REGX52.H>
   2          #include "Delay.h"
   3          sbit RCK = P3^5;        //RCLK 给高电平把数据送到io口
   4          sbit SCK = P3^6;        //SRCLK 给高电平时移位，即下移
   5          sbit SER = P3^4;        //SER 存01数据的
   6          
   7          #define MATRIX_LED_PORT P0
   8          
   9          /**
  10            * @brief  74HC595写入一个字节
  11            * @param 写入的字节
  12            * @retval 
  13            */
  14          void _74HC595_WriteBytes(unsigned char Bytes)
  15          {
  16   1              unsigned char i;
  17   1              for(i = 0;i<8;i++)
  18   1              {
  19   2                      SER = Bytes&(0x80>>i); //非0即1
  20   2                      SCK = 1;
  21   2                      SCK = 0;
  22   2              }
  23   1              RCK = 1;
  24   1              RCK = 0;
  25   1      }
  26          
  27          /**
  28            * @brief LED显示一列数据
  29            * @param Column为要选择的列 0-7，Data是要显示的数据，高位在上，1点亮
  30            * @retval 
  31            */
  32          void MatrixLED_ShowColumn(unsigned char Column,unsigned char Data)
  33          {
  34   1              _74HC595_WriteBytes(Data);
  35   1              MATRIX_LED_PORT = ~(0x80>>Column);//列是阴极，低电平点亮
  36   1              Delay(1);
  37   1              MATRIX_LED_PORT = 0xFF;
  38   1      }
  39          
