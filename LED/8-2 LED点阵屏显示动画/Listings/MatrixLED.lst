line level    source

   1          #include <REGX52.H>
   2          #include "Delay.h"
   3          
   4          sbit RCK = P3^5;        //RCLK 给高电平把数据送到io口
   5          sbit SCK = P3^6;        //SRCLK 给高电平时移位，即下移
   6          sbit SER = P3^4;        //SER 存01数据的
   7          
   8          #define MATRIX_LED_PORT P0
   9          
  10          /**
  11            * @brief  74HC595写入一个字节
  12            * @param 写入的字节
  13            * @retval 
  14            */
  15          void _74HC595_WriteBytes(unsigned char Bytes)
  16          {
  17   1              unsigned char i;
  18   1              for(i = 0;i<8;i++)
  19   1              {
  20   2                      SER = Bytes&(0x80>>i); //非0即1
  21   2                      SCK = 1;
  22   2                      SCK = 0;
  23   2              }
  24   1              RCK = 1;
  25   1              RCK = 0;
  26   1      }
  27          
  28          /**
  29            * @brief LED显示一列数据
  30            * @param Column为要选择的列 0-7，Data是要显示的数据，高位在上，1点亮
  31            * @retval 
  32            */
  33          void MatrixLED_ShowColumn(unsigned char Column,unsigned char Data)
  34          {
  35   1              _74HC595_WriteBytes(Data);
  36   1              MATRIX_LED_PORT = ~(0x80>>Column);//列是阴极，低电平点亮
  37   1              Delay(1);
  38   1              MATRIX_LED_PORT = 0xFF;
  39   1      }
  40          
  41          /**
  42            * @brief 初始化
  43            * @param 
  44            * @retval 
  45            */
  46          void MatrixLED_Init()
  47          {
  48   1              SCK = 0;
  49   1              RCK = 0;
  50   1      }


