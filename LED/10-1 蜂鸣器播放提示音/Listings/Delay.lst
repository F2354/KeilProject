line level    source

   1          //机械按键的开关闭合瞬间，由于弹性作用会有一个5-10ms的抖动，可以通过delay软
             -件消抖
   2          /**
   3            * @brief  延时函数，11.0592MHz调用可延时xms * 1ms
   4            * @param  延时ms
   5            * @retval 无
   6            */
   7          void Delay(unsigned int xms)            //@11.0592MHz
   8          {
   9   1              unsigned char i, j;
  10   1              while(xms)
  11   1              {
  12   2                      
  13   2                      i = 2;
  14   2                      j = 199;
  15   2                      do
  16   2                      {
  17   3                              while (--j);
  18   3                      } while (--i);
  19   2                      xms--;
  20   2              }
  21   1      
  22   1      }


