  22            * @param 一个字节
  23            * @retval 
  24            */
  25          void UART_SendBytes(unsigned char Bytes)
  26          {
  27   1              SBUF = Bytes;
  28   1              while(TI == 0);
  29   1              TI = 0;
  30   1      }
