   1          #include <REGX52.H>
   2          /**
   3            * @brief 串口初始化，4800bps@11.0592MHz
   4            * @param 
   5            * @retval 
   6            */
   7          void UART_Init() 
   8          {
   9   1              PCON &= 0x80;           //波特率不倍速
  10   1              SCON = 0x50;            //允许接受
  11   1              TMOD &= 0x0F;           //设置定时器模式
  12   1              TMOD |= 0x20;           //设置定时器模式
  13   1              TL1 = 0xFA;             //设定定时初值
  14   1              TH1 = 0xFA;             //设定定时器重装值
  15   1              ET1 = 0;                //禁止定时器1中断
  16   1              TR1 = 1;                //启动定时器1
  17   1              EA = 1;
  18   1              ES = 1;
  19   1      }
  20          /**
